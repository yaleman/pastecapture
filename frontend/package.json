{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:openapi": "PYTHONPATH=.. uv run --project .. python -m pastecapture.generate_openapi --output openapi.json",
    "generate:types": "openapi-typescript openapi.json -o src/api/schema.generated.ts",
    "generate:api": "pnpm run generate:openapi && pnpm run generate:types",
    "predev": "pnpm run generate:api",
    "prebuild": "pnpm run generate:api",
    "dev": "vite",
    "build": "tsc && vite build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1"
  }
}
